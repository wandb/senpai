FROM python:3.13-slim-bookworm

ARG PLAYWRIGHT_VERSION=1.55.0
ARG SENPAI_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision="${SENPAI_SOURCE_REVISION}"

ENV PATH="/opt/senpai-venv/bin:/home/senpai/.local/bin:${PATH}" \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    SENPAI_AGENT_DIR=/opt/senpai-agent-definitions \
    SENPAI_IMAGE_REVISION="${SENPAI_SOURCE_REVISION}" \
    SENPAI_PYTHON=/opt/senpai-venv/bin/python \
    UV_PYTHON=/opt/senpai-venv/bin/python \
    UV_PYTHON_DOWNLOADS=never \
    BROWSER_USE_DISABLE_EXTENSIONS=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl git gnupg procps tmux && \
    groupadd --gid 10001 senpai && \
    useradd --uid 10001 --gid 10001 --create-home senpai && \
    rm -rf /var/lib/apt/lists/*

# Install gh from its architecture-neutral apt repository.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli-stable.list && \
    apt-get update && apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir "uv==0.10.9" && \
    uv venv --python /usr/local/bin/python /opt/senpai-venv

# Export from the project lock while pruning dependencies used only for training.
COPY pyproject.toml uv.lock /tmp/senpai/
COPY senpai_agent /tmp/senpai/senpai_agent
COPY .agents/agents /opt/senpai-agent-definitions
RUN cd /tmp/senpai && \
    uv export --locked --python 3.13 --no-dev --no-emit-project \
      --format requirements.txt \
      --prune torch \
      --prune torchvision \
      --prune torch-geometric \
      --prune timm \
      --prune einops \
      --prune matplotlib \
      > requirements.txt && \
    uv pip install --python "$SENPAI_PYTHON" \
      --only-binary cryptography \
      --only-binary jiter \
      --only-binary litellm \
      --only-binary pycparser \
      --only-binary pydantic-core \
      --only-binary rpds-py \
      -r requirements.txt && \
    uv pip install --python "$SENPAI_PYTHON" --no-deps /tmp/senpai && \
    python -c 'import importlib.metadata, importlib.util, openhands.sdk, senpai_agent, sys; assert sys.version_info[:2] == (3, 13); assert importlib.util.find_spec("torch") is None; assert importlib.metadata.version("openhands-sdk") == "1.40.0"; assert importlib.metadata.version("weave-openhands") == "0.1.0"' && \
    chown -R root:root /opt/senpai-venv "$SENPAI_AGENT_DIR" && \
    chmod -R a-w /opt/senpai-venv "$SENPAI_AGENT_DIR" && \
    rm -rf /root/.cache/uv /tmp/senpai

COPY scripts/senpai-browser-smoke-test.py /usr/local/bin/senpai-browser-smoke-test

# Expose the pinned browser on PATH because launchers give roles a persistent HOME.
RUN uvx --from "playwright==${PLAYWRIGHT_VERSION}" \
      playwright install chromium --with-deps --no-shell && \
    chromium_path=$(find "$PLAYWRIGHT_BROWSERS_PATH" \
      -type f -path '*/chrome-linux*/chrome' -print -quit) && \
    test -x "$chromium_path" && \
    ln -s "$chromium_path" /usr/local/bin/chromium && \
    chmod +x /usr/local/bin/senpai-browser-smoke-test && \
    mkdir -p /workspace /workspaces /var/lib/senpai && \
    chown -R 10001:10001 \
      /home/senpai /workspace /workspaces /var/lib/senpai && \
    rm -rf /root/.cache/uv /root/.config/browseruse /var/lib/apt/lists/*

ENV HOME=/home/senpai

WORKDIR /workspaces
USER 10001:10001

# Exercise the browser as the same non-root user used in production.
RUN HOME=/var/lib/senpai/home senpai-browser-smoke-test
