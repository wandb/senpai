FROM python:3.13-slim-bookworm

ARG PLAYWRIGHT_VERSION=1.55.0
ARG KUBECTL_VERSION=v1.33.4
ARG SENPAI_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision="${SENPAI_SOURCE_REVISION}"

ENV PATH="/opt/senpai-venv/bin:/home/senpai/.local/bin:${PATH}" \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    SENPAI_IMAGE_REVISION="${SENPAI_SOURCE_REVISION}" \
    SENPAI_PYTHON=/opt/senpai-venv/bin/python \
    UV_PROJECT_ENVIRONMENT=/opt/senpai-venv \
    UV_PYTHON=/opt/senpai-venv/bin/python \
    UV_PYTHON_DOWNLOADS=never \
    BROWSER_USE_DISABLE_EXTENSIONS=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl gettext-base git gnupg procps tmux && \
    groupadd --gid 10001 senpai && \
    useradd --uid 10001 --gid 10001 --create-home senpai && \
    rm -rf /var/lib/apt/lists/*

# Install gh from its architecture-neutral apt repository.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli-stable.list && \
    apt-get update && apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# The operational-supervisor deployment uses kubectl through both its typed
# campaign operations and native terminal. Pin and verify the shipped client.
RUN architecture="$(dpkg --print-architecture)" && \
    case "$architecture" in \
      amd64|arm64) ;; \
      *) echo "unsupported kubectl architecture: $architecture" >&2; exit 1 ;; \
    esac && \
    curl -fsSLo /tmp/kubectl \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${architecture}/kubectl" && \
    curl -fsSLo /tmp/kubectl.sha256 \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${architecture}/kubectl.sha256" && \
    printf '%s  %s\n' "$(cat /tmp/kubectl.sha256)" /tmp/kubectl | sha256sum --check && \
    install -m 0755 /tmp/kubectl /usr/local/bin/kubectl && \
    rm -f /tmp/kubectl /tmp/kubectl.sha256

RUN python -m pip install --no-cache-dir "uv==0.10.9" && \
    uv venv --python /usr/local/bin/python /opt/senpai-venv

# Export from the project lock while pruning dependencies used only for training.
COPY pyproject.toml uv.lock /tmp/senpai/
RUN cd /tmp/senpai && \
    uv export --locked --python 3.13 --no-dev --no-emit-project \
      --format requirements.txt \
      --prune torch \
      --prune torchvision \
      --prune torch-geometric \
      --prune timm \
      --prune einops \
      --prune matplotlib \
      > requirements.txt && \
    uv pip install --python "$SENPAI_PYTHON" \
      --only-binary cryptography \
      --only-binary jiter \
      --only-binary litellm \
      --only-binary pycparser \
      --only-binary pydantic-core \
      --only-binary rpds-py \
      -r requirements.txt && \
    python -c 'import importlib.metadata, importlib.util, openhands.sdk, sys; assert sys.version_info[:2] == (3, 13); assert importlib.util.find_spec("torch") is None; assert importlib.metadata.version("openhands-sdk") == "1.40.0"; assert importlib.metadata.version("weave-openhands") == "0.1.0"' && \
    chown -R 10001:10001 /opt/senpai-venv && \
    rm -rf /root/.cache/uv

COPY scripts/senpai-browser-smoke-test.py /usr/local/bin/senpai-browser-smoke-test
COPY scripts/senpai-container-health.sh /usr/local/bin/senpai-container-health

# Expose the pinned browser on PATH because launchers give roles a persistent HOME.
RUN uvx --from "playwright==${PLAYWRIGHT_VERSION}" \
      playwright install chromium --with-deps --no-shell && \
    chromium_path=$(find "$PLAYWRIGHT_BROWSERS_PATH" \
      -type f -path '*/chrome-linux*/chrome' -print -quit) && \
    test -x "$chromium_path" && \
    ln -s "$chromium_path" /usr/local/bin/chromium && \
    chmod +x /usr/local/bin/senpai-browser-smoke-test \
      /usr/local/bin/senpai-container-health && \
    mkdir -p /workspace /workspaces /var/lib/senpai && \
    chown -R 10001:10001 \
      /home/senpai /workspace /workspaces /var/lib/senpai && \
    rm -rf /root/.cache/uv /root/.config/browseruse /var/lib/apt/lists/*

ENV HOME=/home/senpai

HEALTHCHECK --interval=30s --timeout=5s --start-period=10m --retries=5 \
    CMD senpai-container-health \
      "/var/lib/senpai/${RESEARCH_TAG}/advisor/openhands_state/controller-lease.json"

WORKDIR /workspaces
USER 10001:10001

# Exercise the browser as the same non-root user used in production.
RUN HOME=/var/lib/senpai/home senpai-browser-smoke-test
