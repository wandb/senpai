FROM ghcr.io/coreweave/ml-containers/torch-extras:b1daf4e-base-cuda13.2.1-ubuntu24.04-torch2.12.0-vision0.27.0-audio2.11.0-abi1

ARG PYTHON_VERSION=3.13
ARG PLAYWRIGHT_VERSION=1.55.0
ARG SENPAI_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision="${SENPAI_SOURCE_REVISION}"

ENV PATH="/opt/senpai-venv/bin:/home/senpai/.local/bin:${PATH}" \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    SENPAI_IMAGE_REVISION="${SENPAI_SOURCE_REVISION}" \
    BROWSER_USE_DISABLE_EXTENSIONS=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl git gnupg procps && \
    groupadd --gid 10001 senpai && \
    useradd --uid 10001 --gid 10001 --create-home senpai && \
    rm -rf /var/lib/apt/lists/*

# Install gh from its architecture-neutral apt repository.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli-stable.list && \
    apt-get update && apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# The CoreWeave base currently ships Python 3.12. Use a pinned uv to install
# CPython 3.13 and make it the image-wide python/python3 runtime.
RUN python3 -m pip install --no-cache-dir "uv==0.10.9" && \
    uv python install --install-dir "$UV_PYTHON_INSTALL_DIR" "$PYTHON_VERSION" && \
    uv venv --python "$PYTHON_VERSION" /opt/senpai-venv && \
    python --version

ENV SENPAI_PYTHON=/opt/senpai-venv/bin/python \
    UV_PROJECT_ENVIRONMENT=/opt/senpai-venv \
    UV_PYTHON=/opt/senpai-venv/bin/python \
    UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock /tmp/senpai/
RUN cd /tmp/senpai && \
    uv export --locked --python 3.13 --no-dev --no-emit-project \
      --format requirements.txt > requirements.txt && \
    uv pip install --python "$SENPAI_PYTHON" --upgrade \
      --only-binary cryptography \
      --only-binary jiter \
      --only-binary litellm \
      --only-binary pycparser \
      --only-binary pydantic-core \
      --only-binary rpds-py \
      -r requirements.txt && \
    python -c 'import importlib.metadata, openhands.sdk, sys, torch; assert sys.version_info[:2] == (3, 13); assert torch.__version__.startswith("2.13."); assert torch.version.cuda and torch.version.cuda.startswith("13."); assert importlib.metadata.version("openhands-sdk") == "1.40.0"; assert importlib.metadata.version("weave-openhands") == "0.1.0"' && \
    chown -R 10001:10001 /opt/senpai-venv "$UV_PYTHON_INSTALL_DIR" && \
    rm -rf /root/.cache/uv

COPY scripts/senpai-browser-smoke-test.py /usr/local/bin/senpai-browser-smoke-test
COPY scripts/senpai-container-health.sh /usr/local/bin/senpai-container-health

# Expose the pinned browser on PATH because launchers give roles a persistent HOME.
RUN uvx --from "playwright==${PLAYWRIGHT_VERSION}" \
      playwright install chromium --with-deps --no-shell && \
    chromium_path=$(find "$PLAYWRIGHT_BROWSERS_PATH" \
      -type f -path '*/chrome-linux*/chrome' -print -quit) && \
    test -x "$chromium_path" && \
    ln -s "$chromium_path" /usr/local/bin/chromium && \
    chmod +x /usr/local/bin/senpai-browser-smoke-test \
      /usr/local/bin/senpai-container-health && \
    mkdir -p /workspace /workspaces /var/lib/senpai && \
    chown -R 10001:10001 \
      /home/senpai /workspace /workspaces /var/lib/senpai && \
    rm -rf /root/.cache/uv /root/.config/browseruse /var/lib/apt/lists/*

# Use the standard NVIDIA Container Toolkit contract on supported x86_64 hosts.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_REQUIRE_CUDA="cuda>=13.0" \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0;10.0;10.3;12.0+PTX"

COPY scripts/senpai-gpu-smoke-test.py /usr/local/bin/senpai-gpu-smoke-test
RUN chmod +x /usr/local/bin/senpai-gpu-smoke-test && \
    python -c 'import torch; required={"sm_75", "sm_80", "sm_86", "sm_90", "sm_100", "sm_120"}; assert required <= set(torch.cuda.get_arch_list())' && \
    python -c 'from torch.utils.cpp_extension import _get_cuda_arch_flags; assert _get_cuda_arch_flags()'

ENV HOME=/home/senpai

HEALTHCHECK --interval=30s --timeout=5s --start-period=10m --retries=5 \
    CMD senpai-container-health \
      "/var/lib/senpai/openhands_state/controller-lease.json"

WORKDIR /workspaces
USER 10001:10001

# Exercise the browser as the same non-root user used in production.
RUN HOME=/var/lib/senpai/home senpai-browser-smoke-test
