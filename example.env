# This is the only credential file used by Senpai. Copy it once, then fill in
# the values:
#   cp example.env .env
#
# `.env` is gitignored and automatically restricted to mode 0600. Never
# commit it. Workload keys reach advisor and student roles through the selected
# backend's native secret mechanism; scout-only keys are routed only to scout.
#
# Prefer a deliberately created classic PAT (`ghp_...`) for launch, not a
# copied GitHub CLI OAuth token (`gho_...`). Required scopes for private org
# repos: repo + read:org. The token also needs clone + push + PR-open on the
# `target_repo_url` you launch against.

GITHUB_TOKEN=
ANTHROPIC_API_KEY=
EXA_API_KEY=
WANDB_API_KEY=

# Add any other workload credential below. No launcher code change is needed.
# HF_TOKEN=
# SLACK_WEBHOOK_URL=
# KUBECONFIG_B64=
# SEMANTIC_SCHOLAR_API_KEY=
